@@ -0,0 +1,28 @@
+/* Passive constructor-reset prefix, task native-reset-prefix-20261021. No control or clock writes. */
+#ifndef GPGX_RESET_PREFIX_H
+#define GPGX_RESET_PREFIX_H
+#include <stdint.h>
+#define GPGX_RESET_PREFIX_WORDS 40
+#define GPGX_RESET_PREFIX_CAPACITY 128
+#ifdef GPGX_RESET_PREFIX_ENABLED
+void gpgx_reset_prefix_init_begin(void);
+void gpgx_reset_prefix_init_end(void);
+void gpgx_reset_prefix_reset_enter(void);
+void gpgx_reset_prefix_reset_leave(uint32_t cost);
+void gpgx_reset_prefix_fetch(void);
+void gpgx_reset_prefix_decoded(uint32_t ir);
+void gpgx_reset_prefix_retire(void);
+void gpgx_reset_prefix_bus(uint32_t address, uint32_t value, uint32_t width, uint32_t write);
+void gpgx_reset_prefix_unsupported(void);
+#else
+#define gpgx_reset_prefix_init_begin() ((void)0)
+#define gpgx_reset_prefix_init_end() ((void)0)
+#define gpgx_reset_prefix_reset_enter() ((void)0)
+#define gpgx_reset_prefix_reset_leave(cost) ((void)0)
+#define gpgx_reset_prefix_fetch() ((void)0)
+#define gpgx_reset_prefix_decoded(ir) ((void)0)
+#define gpgx_reset_prefix_retire() ((void)0)
+#define gpgx_reset_prefix_bus(a,v,w,d) ((void)0)
+#define gpgx_reset_prefix_unsupported() ((void)0)
+#endif
+#endif
