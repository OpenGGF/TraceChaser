diff --git a/waterbox/gpgx/cinterface/reset_prefix.c b/waterbox/gpgx/cinterface/reset_prefix.c
new file mode 100644
index 0000000..8e46ae2
--- /dev/null
+++ b/waterbox/gpgx/cinterface/reset_prefix.c
@@ -0,0 +1,118 @@
+/* Constructor-reset-to-first-VDP-status observation, native-reset-prefix-20261021.
+ * Inputs: pinned GPGX live state only. Outputs: bounded ordered comparison records.
+ * The observer never supplies values to the CPU, bus, devices, RAM or clocks.
+ */
+#include <stdint.h>
+#include <string.h>
+#include "m68kconf.h"
+#include "shared.h"
+#include "emulibc.h"
+#define GPGX_RESET_PREFIX_ENABLED 1
+#include "reset_prefix.h"
+#define RP_EX ECL_EXPORT
+#define RP_I ECL_INVISIBLE
+RP_I static uint32_t rp_records[GPGX_RESET_PREFIX_CAPACITY][GPGX_RESET_PREFIX_WORDS];
+RP_I static uint32_t rp_count, rp_init, rp_ready, rp_seen_fetch, rp_armed, rp_ever_armed;
+RP_I static uint32_t rp_active, rp_stop, rp_complete, rp_fault, rp_fetch_pc;
+
+static void rp_record(uint32_t kind, uint32_t address, uint32_t value, uint32_t width, uint32_t aux)
+{
+  uint32_t *p, i;
+  if (rp_fault) return;
+  if (rp_count == GPGX_RESET_PREFIX_CAPACITY) { rp_fault=3; return; }
+  p=rp_records[rp_count]; memset(p,0,GPGX_RESET_PREFIX_WORDS*4);
+  p[0]=kind; p[1]=rp_count++; p[2]=m68k.pc; p[3]=m68k.cycles; p[4]=m68k.refresh_cycles;
+  p[5]=m68k_get_reg(M68K_REG_SR); p[6]=m68k.int_level; p[7]=Z80.cycles;
+  p[8]=zstate; p[9]=zbank; p[10]=address; p[11]=value; p[12]=width;
+  /* Knownness=1 means actual emulator value; no claim of physical power-on RAM/register certainty. */
+  p[13]=1;
+  for(i=0;i<16;i++) p[14+i]=m68k_get_reg(M68K_REG_D0+i);
+  p[30]=m68k_get_reg(M68K_REG_IR); p[31]=system_hw; p[32]=region_code;
+  p[33]=vdp_pal; p[34]=lines_per_frame; p[35]=io_reg[0];
+  p[36]=io_reg[4]|((uint32_t)io_reg[5]<<8)|((uint32_t)io_reg[6]<<16);
+  p[37]=config.bios; p[38]=cart.romsize; p[39]=kind>=4?rp_fetch_pc:aux;
+}
+void gpgx_reset_prefix_init_begin(void)
+{
+  /* Only native gpgx_init owns this boundary; reset-button paths never call it. */
+  rp_count=rp_fault=rp_ready=rp_seen_fetch=rp_armed=rp_ever_armed=0;
+  rp_active=rp_stop=rp_complete=0; rp_init=1;
+}
+void gpgx_reset_prefix_reset_enter(void)
+{
+  if (rp_init && !rp_count) rp_record(1,0,0,0,0);
+  else { rp_ready=0; if(rp_ever_armed) rp_fault=4; }
+}
+void gpgx_reset_prefix_reset_leave(uint32_t cost)
+{
+  if (rp_init && rp_count==1) rp_record(2,0,0,0,cost);
+}
+void gpgx_reset_prefix_init_end(void)
+{
+  if (!rp_init || rp_seen_fetch || rp_count!=2) { rp_fault=4; return; }
+  /* Profile payload: actual port systems, pad types and SRAM on/detected/custom flags. */
+  rp_record(3,input.system[0]|((uint32_t)input.system[1]<<8),
+    input.dev[0]|((uint32_t)input.dev[4]<<8),
+    sram.on|((uint32_t)sram.detected<<8)|((uint32_t)sram.custom<<16),0);
+  rp_init=0; rp_ready=1;
+}
+RP_EX uint32_t gpgx_reset_prefix_abi_version(void) { return 1; }
+RP_EX int gpgx_reset_prefix_layout(uint32_t *p,uint32_t count)
+{
+  if(!p || count!=4) return -2;
+  p[0]=160; p[1]=GPGX_RESET_PREFIX_CAPACITY; p[2]=GPGX_RESET_PREFIX_WORDS; p[3]=1; return 0;
+}
+RP_EX int gpgx_reset_prefix_enable(uint32_t abi)
+{
+  if(abi!=1) return -2;
+  if(rp_fault) return -(int)rp_fault;
+  if(!rp_ready || rp_seen_fetch || rp_ever_armed || rp_count!=3 || system_hw!=SYSTEM_MD
+    || config.bios || m68k.int_level || m68k.cycles!=rp_records[2][3]
+    || m68k.refresh_cycles!=rp_records[2][4] || m68k.pc!=rp_records[2][2]
+    || Z80.cycles!=rp_records[2][7]) { rp_fault=4; return -4; }
+  rp_ever_armed=rp_armed=1; return 0;
+}
+RP_EX int gpgx_reset_prefix_read(uint32_t *p,uint32_t capacity,uint32_t *records,uint32_t *status)
+{
+  if(!p || !records || !status) return -2;
+  *records=rp_count; *status=rp_complete;
+  if(rp_fault) return -(int)rp_fault;
+  if(!rp_armed) return -4;
+  if(capacity<rp_count*GPGX_RESET_PREFIX_WORDS) { rp_fault=3; return -3; }
+  memcpy(p,rp_records,rp_count*GPGX_RESET_PREFIX_WORDS*4); return 0;
+}
+RP_EX int gpgx_reset_prefix_disable(void) { rp_armed=0; return 0; }
+void gpgx_reset_prefix_unsupported(void) { if(rp_armed && !rp_complete) rp_fault=4; }
+void gpgx_reset_prefix_fetch(void)
+{
+  rp_seen_fetch=1;
+  if(!rp_armed || rp_complete || rp_fault) return;
+  if(rp_active || m68k.int_level || m68k.pc>=cart.romsize) { rp_fault=4; return; }
+  rp_fetch_pc=m68k.pc; rp_active=1; rp_record(4,0,0,0,0);
+}
+void gpgx_reset_prefix_decoded(uint32_t ir)
+{
+  if(rp_armed && !rp_complete && !rp_fault && rp_active && rp_count
+    && rp_records[rp_count-1][0]==4) rp_records[rp_count-1][30]=ir;
+}
+void gpgx_reset_prefix_retire(void)
+{
+  if(!rp_armed || rp_complete || rp_fault) return;
+  if(!rp_active) { rp_fault=4; return; }
+  rp_record(5,0,0,0,0); rp_active=0;
+  if(rp_stop && !rp_fault) rp_complete=1;
+}
+void gpgx_reset_prefix_bus(uint32_t address,uint32_t value,uint32_t width,uint32_t write)
+{
+  int supported;
+  if(!rp_armed || rp_complete || rp_fault) return;
+  address &= 0xffffff;
+  /* This bounded grammar owns only cold-entry ROM reads, IO control/version tests and the first status read.
+   * TMSS/BIOS-on, RAM, Z80 bus work and all other producers are deliberately unsupported. */
+  supported=!write && ((address<cart.romsize && width<=cart.romsize-address)
+    || (address==0xa10008 && width==4) || (address==0xa1000c && width==2)
+    || (address==0xa10001 && width==1) || (address==0xc00004 && width==2));
+  if(!rp_active || !supported) { rp_fault=4; return; }
+  rp_record(write?7:6,address,value,width,0);
+  if(address==0xc00004) rp_stop=1;
+}
