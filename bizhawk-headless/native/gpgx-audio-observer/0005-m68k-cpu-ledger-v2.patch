+/* Observation-only 68000 CPU ledger, stall ABI v2 (OpenGGF, 0005). Independent of every other ABI, including v1.
+   State is ECL_INVISIBLE (never savestated). Every core hook is one branch on gpgx_m68k_stall2_enabled and only reads
+   values the core already computed. Read only between frames. Return codes: 0 ok, -1 not enabled, -2 ABI/size
+   mismatch, -3 sticky capacity or accounting failure, -4 sticky discontinuity (reset, loadstate, bus/address error). */
+#define GPGX_M68K_STALL2_ABI_VERSION 2u
+#define GPGX_M68K_STALL2_SLOTS 6144u            /* per bank */
+#define GPGX_M68K_STALL2_MAX_LOAD 4608u         /* 75% load: a bank beyond this fails closed */
+#define GPGX_M68K_STALL2_MAX_PROBE 64u
+#define GPGX_M68K_STALL2_BANKS 3u               /* one open, up to two closed and unread */
+#define GPGX_M68K_STALL2_RING 512u              /* acceptance records between two reads (>= one per line + VInt) */
+#define GPGX_M68K_STALL2_FRAMES 8u              /* nested exception frames tracked for context */
+
+enum gpgx_m68k_stall2_kind
+{
+  GPGX_M68K_STALL2_Z80_BUS = 0,    /* memz80.c z80_request_68k_bus_access */
+  GPGX_M68K_STALL2_FIFO = 1,       /* vdp_ctrl.c FIFO-full wait */
+  GPGX_M68K_STALL2_DMA = 2,        /* vdp_ctrl.c 68k-bus DMA freeze, forward */
+  GPGX_M68K_STALL2_DMA_REWIND = 3, /* same site when dma_endCycles < m68k.cycles (subtracted) */
+  GPGX_M68K_STALL2_Z80_AREA = 4,   /* mem68k.c Z80-window access latency */
+  GPGX_M68K_STALL2_LOCKUP = 5,     /* mem68k.c illegal-area lockup jump to cycle_end */
+  GPGX_M68K_STALL2_STOPPED = 6,    /* m68kcpu.c stopped CPU skips to the slice end */
+  GPGX_M68K_STALL2_ACCEPT_VINT = 7,
+  GPGX_M68K_STALL2_ACCEPT_HINT = 8,
+  GPGX_M68K_STALL2_ACCEPT_OTHER = 9,
+  GPGX_M68K_STALL2_KINDS = 10
+};
+
+#define GPGX_M68K_STALL2_FLAG_RING_OVERFLOW 0x01u
+#define GPGX_M68K_STALL2_FLAG_BANK_OVERFLOW 0x02u
+#define GPGX_M68K_STALL2_FLAG_BANK_OVERRUN 0x04u
+#define GPGX_M68K_STALL2_FLAG_FRAME_STACK 0x08u
+#define GPGX_M68K_STALL2_FLAG_ACCOUNTING 0x10u   /* begin while active, end without begin, slot overflow */
+#define GPGX_M68K_STALL2_FLAG_DISCONTINUITY 0x100u
+#define GPGX_M68K_STALL2_FLAG_RESET 0x200u
+#define GPGX_M68K_STALL2_FLAG_BUS_ERROR 0x400u
+
+struct gpgx_m68k_stall2_slot      /* key: pc[23:0] | context << 24 | 1 << 31 */
+{
+  uint32_t key;
+  uint32_t count;                 /* instruction starts at pc in this context */
+  uint32_t mclk;                  /* instruction MCLK excluding refresh and every classified stall */
+};
+
+struct gpgx_m68k_stall2_accept    /* one per accepted interrupt */
+{
+  uint32_t ordinal;               /* acceptances since enable */
+  uint8_t level;
+  uint8_t inside_instruction;     /* 1 when accepted inside an instruction (SR change or irq-delay path) */
+  uint8_t table_index;            /* (m68k.cycles / 7) % 10 */
+  uint8_t cycles;                 /* m68ki_cycle_interrupts[table_index] / 7 */
+  uint32_t return_pc;             /* stacked PC */
+  uint32_t frame_ordinal;
+  uint64_t stamp_mclk;            /* monotonic: frame base + m68k.cycles at acceptance start */
+  uint32_t closes_bank_sequence;  /* sequence of the bank this VInt closed, else 0xFFFFFFFF */
+  uint32_t reserved;
+};
+
+struct gpgx_m68k_stall2_bank
+{
+  uint32_t sequence;              /* closes in order from 0 after enable */
+  uint8_t opened_by_vint;         /* 0: opened by enable (partial, never an interval) */
+  uint8_t reserved0[3];
+  uint32_t open_accept_ordinal;   /* 0xFFFFFFFF when opened by enable */
+  uint32_t close_accept_ordinal;
+  uint32_t entries;
+  uint32_t straddle_pc;           /* instruction in flight at the closing acceptance, else 0xFFFFFFFF */
+  uint32_t straddle_context;
+  uint32_t straddle_mclk;         /* its MCLK before the acceptance, already included in its slot */
+  uint32_t carry_pc;              /* instruction in flight at the opening acceptance, else 0xFFFFFFFF */
+  uint32_t carry_mclk;            /* its MCLK after that acceptance; not in any slot of this bank */
+  uint32_t refresh_events;
+  uint32_t accept_counts[3];      /* VInt, HInt, other levels */
+  uint32_t irq_delay_inline;      /* instructions executed inside m68k_set_irq_delay */
+  uint32_t synthetic_rte;         /* RTE with no matching tracked frame (context unchanged) */
+  uint32_t abandoned_frames;      /* tracked frames unwound without RTE */
+  uint32_t reserved1;
+  uint64_t executed;              /* instruction starts counted */
+  uint64_t open_stamp_mclk;
+  uint64_t close_stamp_mclk;
+  uint64_t kind_mclk[GPGX_M68K_STALL2_KINDS];
+};
+
+struct gpgx_m68k_stall2_frame     /* state between FrameAdvance calls */
+{
+  uint32_t abi_version;
+  uint32_t flags;                 /* sticky GPGX_M68K_STALL2_FLAG_* */
+  uint32_t frame_ordinal;
+  uint32_t vint_accepts;          /* level-6 acceptances since enable */
+  uint32_t ring_pending;
+  uint32_t closed_banks;
+  uint32_t open_bank_sequence;
+  uint32_t context;               /* 0 main, 1 interrupt, at the frame boundary */
+  uint64_t stamp_mclk;            /* frame base + m68k.cycles now */
+};
+
+extern volatile uint8_t gpgx_m68k_stall2_enabled;
+void gpgx_m68k_stall2_fetch(uint32_t pc);
+void gpgx_m68k_stall2_begin(uint32_t ir, uint32_t sp);
+void gpgx_m68k_stall2_end(void);
+void gpgx_m68k_stall2_inline_close(void);
+void gpgx_m68k_stall2_inline_begin(uint32_t ir, uint32_t sp);
+void gpgx_m68k_stall2_classify(uint32_t kind, uint32_t mclk);
+void gpgx_m68k_stall2_dma(uint32_t before, uint32_t after);
+void gpgx_m68k_stall2_note_return(uint32_t pc);
+void gpgx_m68k_stall2_frame_pushed(uint32_t sp);
+void gpgx_m68k_stall2_refresh(void);
+void gpgx_m68k_stall2_jump(uint32_t kind, uint32_t before, uint32_t after);
+void gpgx_m68k_stall2_bus_error(void);
+void gpgx_m68k_stall2_accept(uint32_t level, uint32_t table_index, uint32_t cost_mclk);
+void gpgx_m68k_stall2_frame_begin(uint32_t cycles, uint32_t refresh, uint32_t pc, uint32_t z80);
+void gpgx_m68k_stall2_frame_end(uint32_t mcycles, uint32_t cycles, uint32_t refresh, uint32_t pc, uint32_t z80);
+void gpgx_m68k_stall2_reset(void);
+#define GPGX_M68K_STALL2(call) do { if (gpgx_m68k_stall2_enabled) call; } while (0)
 uint8_t gpgx_audio_trace_enter_cpu(uint8_t cpu);
 void gpgx_audio_trace_leave_cpu(uint8_t previous);
 void gpgx_audio_trace_s2_request_callback_begin(uint32_t pc);
