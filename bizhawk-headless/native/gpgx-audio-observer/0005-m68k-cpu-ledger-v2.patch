+/* ---- Observation-only 68000 CPU ledger, stall ABI v2 (0005). See audio_trace.h. ---- */
+ECL_INVISIBLE volatile uint8_t gpgx_m68k_stall2_enabled;
+ECL_INVISIBLE static struct gpgx_m68k_stall2_slot stall2_slots[GPGX_M68K_STALL2_BANKS][GPGX_M68K_STALL2_SLOTS];
+ECL_INVISIBLE static struct gpgx_m68k_stall2_bank stall2_bank[GPGX_M68K_STALL2_BANKS];
+ECL_INVISIBLE static uint8_t stall2_bank_state[GPGX_M68K_STALL2_BANKS];   /* 0 free, 1 open, 2 closed */
+ECL_INVISIBLE static struct gpgx_m68k_stall2_accept stall2_ring[GPGX_M68K_STALL2_RING];
+ECL_INVISIBLE static struct
+{
+  uint32_t flags, frame_ordinal, open, next_sequence, ring_count, accepts, vint_accepts;
+  uint64_t frame_base;
+  uint32_t fetch_pc, cur_active, cur_pc, cur_context, cur_start, cur_inside, cur_carry;
+  uint32_t ret_pc, frame_pending, depth, irq_depth;
+  uint32_t frame_sp[GPGX_M68K_STALL2_FRAMES];
+  uint8_t frame_irq[GPGX_M68K_STALL2_FRAMES];
+  uint32_t fp_valid, fp_cycles, fp_refresh, fp_pc, fp_z80;
+} stall2;
+STATIC_ASSERT(m68k_stall2_slot_size, sizeof(struct gpgx_m68k_stall2_slot) == 12);
+STATIC_ASSERT(m68k_stall2_accept_size, sizeof(struct gpgx_m68k_stall2_accept) == 32);
+STATIC_ASSERT(m68k_stall2_bank_size, sizeof(struct gpgx_m68k_stall2_bank) == 176);
+STATIC_ASSERT(m68k_stall2_frame_size, sizeof(struct gpgx_m68k_stall2_frame) == 40);
+
+static uint64_t stall2_stamp(void) { return stall2.frame_base + (uint32_t)m68k.cycles; }
+
+static void stall2_open_bank(uint32_t opened_by_vint, uint32_t accept_ordinal)
+{
+  uint32_t b;
+  for (b = 0; b < GPGX_M68K_STALL2_BANKS && stall2_bank_state[b] != 0; b++) {}
+  if (b == GPGX_M68K_STALL2_BANKS)
+  {
+    /* both other banks are closed and unread: the interval would be lost */
+    stall2.flags |= GPGX_M68K_STALL2_FLAG_BANK_OVERRUN;
+    b = stall2.open;   /* keep counting into the current bank; every read now fails closed */
+    stall2_bank_state[b] = 1;
+    return;
+  }
+  memset(stall2_slots[b], 0, sizeof(stall2_slots[b]));
+  memset(&stall2_bank[b], 0, sizeof(stall2_bank[b]));
+  stall2_bank[b].opened_by_vint = (uint8_t)opened_by_vint;
+  stall2_bank[b].open_accept_ordinal = opened_by_vint ? accept_ordinal : 0xFFFFFFFFu;
+  stall2_bank[b].close_accept_ordinal = 0xFFFFFFFFu;
+  stall2_bank[b].straddle_pc = 0xFFFFFFFFu;
+  stall2_bank[b].carry_pc = 0xFFFFFFFFu;
+  stall2_bank[b].open_stamp_mclk = stall2_stamp();
+  stall2_bank_state[b] = 1;
+  stall2.open = b;
+}
+
+static struct gpgx_m68k_stall2_slot *stall2_slot(uint32_t pc, uint32_t context)
+{
+  struct gpgx_m68k_stall2_bank *bank = &stall2_bank[stall2.open];
+  uint32_t key = (pc & 0xFFFFFFu) | (context << 24) | 0x80000000u;
+  uint32_t h = ((key * 2654435761u) >> 16) % GPGX_M68K_STALL2_SLOTS, probe;
+  for (probe = 0; probe < GPGX_M68K_STALL2_MAX_PROBE; probe++)
+  {
+    struct gpgx_m68k_stall2_slot *slot = &stall2_slots[stall2.open][(h + probe) % GPGX_M68K_STALL2_SLOTS];
+    if (slot->key == key) return slot;
+    if (slot->key == 0)
+    {
+      if (bank->entries >= GPGX_M68K_STALL2_MAX_LOAD) break;
+      slot->key = key;
+      bank->entries++;
+      return slot;
+    }
+  }
+  stall2.flags |= GPGX_M68K_STALL2_FLAG_BANK_OVERFLOW;
+  return NULL;
+}
+
+static void stall2_add_mclk(uint32_t pc, uint32_t context, uint32_t mclk)
+{
+  struct gpgx_m68k_stall2_slot *slot = stall2_slot(pc, context);
+  if (!slot) return;
+  if (slot->mclk > 0xFFFFFFFFu - mclk) { stall2.flags |= GPGX_M68K_STALL2_FLAG_ACCOUNTING; return; }
+  slot->mclk += mclk;
+}
+
+void gpgx_m68k_stall2_fetch(uint32_t pc) { stall2.fetch_pc = pc & 0xFFFFFFu; }
+
+static void stall2_rte(uint32_t sp)
+{
+  struct gpgx_m68k_stall2_bank *bank = &stall2_bank[stall2.open];
+  /* frames whose stacked words lie below the current SP were unwound without an RTE */
+  while (stall2.depth && stall2.frame_sp[stall2.depth - 1] < sp)
+  {
+    stall2.depth--;
+    if (stall2.frame_irq[stall2.depth]) stall2.irq_depth--;
+    bank->abandoned_frames++;
+  }
+  if (stall2.depth && stall2.frame_sp[stall2.depth - 1] == sp)
+  {
+    stall2.depth--;
+    if (stall2.frame_irq[stall2.depth]) stall2.irq_depth--;
+  }
+  else
+    bank->synthetic_rte++;   /* an RTE through a frame no exception pushed (e.g. a software resume) */
+}
+
+static void stall2_start(uint32_t pc, uint32_t ir, uint32_t sp)
+{
+  struct gpgx_m68k_stall2_slot *slot;
+  if (stall2.cur_active) stall2.flags |= GPGX_M68K_STALL2_FLAG_ACCOUNTING;
+  stall2.cur_active = 1;
+  stall2.cur_pc = pc;
+  stall2.cur_context = stall2.irq_depth ? 1u : 0u;
+  stall2.cur_start = (uint32_t)m68k.cycles;
+  stall2.cur_inside = 0;
+  stall2.cur_carry = 0;
+  slot = stall2_slot(pc, stall2.cur_context);
+  if (slot) slot->count++;
+  stall2_bank[stall2.open].executed++;
+  if (ir == 0x4E73u) stall2_rte(sp);   /* the RTE itself belongs to the context it returns from */
+}
+
+void gpgx_m68k_stall2_begin(uint32_t ir, uint32_t sp) { stall2_start(stall2.fetch_pc, ir, sp); }
+
+void gpgx_m68k_stall2_end(void)
+{
+  uint32_t delta;
+  if (!stall2.cur_active) { stall2.flags |= GPGX_M68K_STALL2_FLAG_ACCOUNTING; return; }
+  delta = (uint32_t)m68k.cycles - stall2.cur_start - stall2.cur_inside;
+  if (stall2.cur_carry)
+    stall2_bank[stall2.open].carry_mclk += delta;
+  else
+    stall2_add_mclk(stall2.cur_pc, stall2.cur_context, delta);
+  stall2.cur_active = 0;
+}
+
+/* m68k_set_irq_delay finishes the current instruction early and executes the next one inline */
+void gpgx_m68k_stall2_inline_close(void) { gpgx_m68k_stall2_end(); }
+
+void gpgx_m68k_stall2_inline_begin(uint32_t ir, uint32_t sp)
+{
+  stall2_bank[stall2.open].irq_delay_inline++;
+  stall2_start(stall2.fetch_pc, ir, sp);
+}
+
+void gpgx_m68k_stall2_classify(uint32_t kind, uint32_t mclk)
+{
+  if (kind >= GPGX_M68K_STALL2_KINDS) { stall2.flags |= GPGX_M68K_STALL2_FLAG_ACCOUNTING; return; }
+  stall2_bank[stall2.open].kind_mclk[kind] += mclk;
+  if (stall2.cur_active) stall2.cur_inside += kind == GPGX_M68K_STALL2_DMA_REWIND ? (uint32_t)-mclk : mclk;
+}
+
+void gpgx_m68k_stall2_dma(uint32_t before, uint32_t after)
+{
+  if (after >= before) gpgx_m68k_stall2_classify(GPGX_M68K_STALL2_DMA, after - before);
+  else gpgx_m68k_stall2_classify(GPGX_M68K_STALL2_DMA_REWIND, before - after);
+}
+
+void gpgx_m68k_stall2_note_return(uint32_t pc) { stall2.ret_pc = pc & 0xFFFFFFu; stall2.frame_pending = 1; }
+
+/* Every 3-word exception frame; it is an interrupt frame only when m68ki_exception_interrupt announced it. */
+void gpgx_m68k_stall2_frame_pushed(uint32_t sp)
+{
+  uint32_t interrupt = stall2.frame_pending;
+  stall2.frame_pending = 0;
+  if (stall2.depth == GPGX_M68K_STALL2_FRAMES) { stall2.flags |= GPGX_M68K_STALL2_FLAG_FRAME_STACK; return; }
+  stall2.frame_sp[stall2.depth] = sp;
+  stall2.frame_irq[stall2.depth] = (uint8_t)(interrupt != 0);
+  stall2.depth++;
+  if (interrupt) stall2.irq_depth++;
+}
+
+void gpgx_m68k_stall2_refresh(void) { stall2_bank[stall2.open].refresh_events++; }
+
+/* A direct jump of m68k.cycles to a later instant (lockup, stopped CPU); a backward jump is an accounting failure. */
+void gpgx_m68k_stall2_jump(uint32_t kind, uint32_t before, uint32_t after)
+{
+  if (after < before) { stall2.flags |= GPGX_M68K_STALL2_FLAG_ACCOUNTING; return; }
+  gpgx_m68k_stall2_classify(kind, after - before);
+}
+
+void gpgx_m68k_stall2_bus_error(void) { stall2.flags |= GPGX_M68K_STALL2_FLAG_BUS_ERROR; }
+
+void gpgx_m68k_stall2_accept(uint32_t level, uint32_t table_index, uint32_t cost_mclk)
+{
+  struct gpgx_m68k_stall2_accept *rec;
+  uint32_t ordinal = stall2.accepts++, closed = 0xFFFFFFFFu;
+  if (level == 6)
+  {
+    /* close the VInt-to-VInt interval at the acceptance instant */
+    struct gpgx_m68k_stall2_bank *old = &stall2_bank[stall2.open];
+    stall2.vint_accepts++;
+    if (stall2.cur_active)
+    {
+      uint32_t partial = (uint32_t)m68k.cycles - stall2.cur_start - stall2.cur_inside;
+      if (!stall2.cur_carry) stall2_add_mclk(stall2.cur_pc, stall2.cur_context, partial);
+      else old->carry_mclk += partial;
+      old->straddle_pc = stall2.cur_pc;
+      old->straddle_context = stall2.cur_context;
+      old->straddle_mclk = partial;
+    }
+    old->close_accept_ordinal = ordinal;
+    old->close_stamp_mclk = stall2_stamp();
+    old->sequence = stall2.next_sequence++;
+    closed = old->sequence;
+    stall2_bank_state[stall2.open] = 2;
+    stall2_open_bank(1, ordinal);
+    if (stall2.cur_active)
+    {
+      stall2_bank[stall2.open].carry_pc = stall2.cur_pc;
+      stall2.cur_start = (uint32_t)m68k.cycles;
+      stall2.cur_inside = 0;
+      stall2.cur_carry = 1;
+    }
+  }
+  if (stall2.ring_count < GPGX_M68K_STALL2_RING)
+  {
+    rec = &stall2_ring[stall2.ring_count++];
+    rec->ordinal = ordinal;
+    rec->level = (uint8_t)level;
+    rec->inside_instruction = (uint8_t)(stall2.cur_active != 0);
+    rec->table_index = (uint8_t)table_index;
+    rec->cycles = (uint8_t)(cost_mclk / 7);
+    rec->return_pc = stall2.ret_pc;
+    rec->frame_ordinal = stall2.frame_ordinal;
+    rec->stamp_mclk = stall2_stamp();
+    rec->closes_bank_sequence = closed;
+    rec->reserved = 0;
+  }
+  else
+    stall2.flags |= GPGX_M68K_STALL2_FLAG_RING_OVERFLOW;
+  gpgx_m68k_stall2_classify(level == 6 ? GPGX_M68K_STALL2_ACCEPT_VINT
+    : level == 4 ? GPGX_M68K_STALL2_ACCEPT_HINT : GPGX_M68K_STALL2_ACCEPT_OTHER, cost_mclk);
+  stall2_bank[stall2.open].accept_counts[level == 6 ? 0 : level == 4 ? 1 : 2]++;
+}
+
+void gpgx_m68k_stall2_frame_begin(uint32_t cycles, uint32_t refresh, uint32_t pc, uint32_t z80)
+{
+  /* Between frames nothing may change the CPU timing state; a mismatch is a loadstate or external edit. */
+  if (stall2.fp_valid && (cycles != stall2.fp_cycles || refresh != stall2.fp_refresh || pc != stall2.fp_pc
+      || z80 != stall2.fp_z80))
+    stall2.flags |= GPGX_M68K_STALL2_FLAG_DISCONTINUITY;
+}
+
+void gpgx_m68k_stall2_frame_end(uint32_t mcycles, uint32_t cycles, uint32_t refresh, uint32_t pc, uint32_t z80)
+{
+  stall2.frame_ordinal++;
+  stall2.frame_base += mcycles;
+  stall2.fp_valid = 1;
+  stall2.fp_cycles = cycles;
+  stall2.fp_refresh = refresh;
+  stall2.fp_pc = pc;
+  stall2.fp_z80 = z80;
+}
+
+void gpgx_m68k_stall2_reset(void) { stall2.flags |= GPGX_M68K_STALL2_FLAG_RESET; }
+
+static int32_t stall2_status(void)
+{
+  if (!gpgx_m68k_stall2_enabled) return -1;
+  if (stall2.flags & 0xFF00u) return -4;
+  if (stall2.flags) return -3;
+  return 0;
+}
+
+ECL_EXPORT uint32_t gpgx_m68k_stall2_abi_version(void) { return GPGX_M68K_STALL2_ABI_VERSION; }
+
+/* out: slot size, accept size, bank size, frame size, slots per bank, max load, banks, ring capacity */
+ECL_EXPORT int32_t gpgx_m68k_stall2_layout(uint32_t *out, uint32_t count)
+{
+  if (!out || count != 8) return -2;
+  out[0] = sizeof(struct gpgx_m68k_stall2_slot);
+  out[1] = sizeof(struct gpgx_m68k_stall2_accept);
+  out[2] = sizeof(struct gpgx_m68k_stall2_bank);
+  out[3] = sizeof(struct gpgx_m68k_stall2_frame);
+  out[4] = GPGX_M68K_STALL2_SLOTS;
+  out[5] = GPGX_M68K_STALL2_MAX_LOAD;
+  out[6] = GPGX_M68K_STALL2_BANKS;
+  out[7] = GPGX_M68K_STALL2_RING;
+  return 0;
+}
+
+ECL_EXPORT int32_t gpgx_m68k_stall2_enable(uint32_t abi_version)
+{
+  if (abi_version != GPGX_M68K_STALL2_ABI_VERSION) return -2;
+  gpgx_m68k_stall2_enabled = 0;
+  memset(&stall2, 0, sizeof(stall2));
+  memset(stall2_bank_state, 0, sizeof(stall2_bank_state));
+  stall2_open_bank(0, 0);
+  gpgx_m68k_stall2_enabled = 1;
+  return 0;
+}
+
+ECL_EXPORT int32_t gpgx_m68k_stall2_read_frame(struct gpgx_m68k_stall2_frame *out, uint32_t size)
+{
+  uint32_t b, closed = 0;
+  if (!out || size != sizeof(struct gpgx_m68k_stall2_frame)) return -2;
+  if (!gpgx_m68k_stall2_enabled) return -1;
+  for (b = 0; b < GPGX_M68K_STALL2_BANKS; b++) closed += stall2_bank_state[b] == 2;
+  out->abi_version = GPGX_M68K_STALL2_ABI_VERSION;
+  out->flags = stall2.flags;
+  out->frame_ordinal = stall2.frame_ordinal;
+  out->vint_accepts = stall2.vint_accepts;
+  out->ring_pending = stall2.ring_count;
+  out->closed_banks = closed;
+  out->open_bank_sequence = stall2.next_sequence;
+  out->context = stall2.irq_depth ? 1u : 0u;
+  out->stamp_mclk = stall2_stamp();
+  return 0;   /* the frame record reports sticky flags; the take calls refuse data while any is set */
+}
+
+ECL_EXPORT int32_t gpgx_m68k_stall2_take_accepts(struct gpgx_m68k_stall2_accept *out, uint32_t size,
+  uint32_t capacity, uint32_t *count)
+{
+  int32_t status;
+  if (!out || !count || size != sizeof(struct gpgx_m68k_stall2_accept)) return -2;
+  status = stall2_status();
+  if (status) return status;
+  if (capacity < stall2.ring_count) return -2;
+  memcpy(out, stall2_ring, stall2.ring_count * sizeof(struct gpgx_m68k_stall2_accept));
+  *count = stall2.ring_count;
+  stall2.ring_count = 0;
+  return 0;
+}
+
+ECL_EXPORT int32_t gpgx_m68k_stall2_take_bank(struct gpgx_m68k_stall2_bank *header, uint32_t header_size,
+  struct gpgx_m68k_stall2_slot *slots, uint32_t slot_size, uint32_t capacity, uint32_t *available)
+{
+  uint32_t b, best = GPGX_M68K_STALL2_BANKS, i, n = 0;
+  int32_t status;
+  if (!header || !slots || !available || header_size != sizeof(struct gpgx_m68k_stall2_bank)
+      || slot_size != sizeof(struct gpgx_m68k_stall2_slot) || capacity < GPGX_M68K_STALL2_MAX_LOAD) return -2;
+  status = stall2_status();
+  if (status) return status;
+  for (b = 0; b < GPGX_M68K_STALL2_BANKS; b++)
+    if (stall2_bank_state[b] == 2 && (best == GPGX_M68K_STALL2_BANKS || stall2_bank[b].sequence < stall2_bank[best].sequence))
+      best = b;
+  *available = 0;
+  if (best == GPGX_M68K_STALL2_BANKS) return 0;
+  *header = stall2_bank[best];
+  for (i = 0; i < GPGX_M68K_STALL2_SLOTS; i++)
+    if (stall2_slots[best][i].key) slots[n++] = stall2_slots[best][i];
+  if (n != stall2_bank[best].entries) return -3;
+  stall2_bank_state[best] = 0;
+  *available = 1;
+  return 0;
+}
+
+ECL_EXPORT int32_t gpgx_m68k_stall2_disable(void)
+{
+  gpgx_m68k_stall2_enabled = 0;
+  return 0;
+}
+
 ECL_EXPORT uint32_t gpgx_s3k_pcm_abi_version(void)
 { return GPGX_S3K_PCM_ABI_VERSION; }
 
