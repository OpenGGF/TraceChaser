+/* Observation-only 68000 stall counters: integer increments on invisible (non-savestated) memory. They never change
+   m68k/Z80/VDP cycles, callback order, inputs or snapshots. Reading before enable fails; there is no silent zero. */
+ECL_INVISIBLE volatile uint8_t gpgx_m68k_stall_enabled;
+ECL_INVISIBLE uint64_t gpgx_m68k_stall_refresh_events;
+ECL_INVISIBLE static struct gpgx_m68k_stall_snapshot_v1 m68k_stall;
+STATIC_ASSERT(m68k_stall_snapshot_v1_size, sizeof(struct gpgx_m68k_stall_snapshot_v1) == 80);
+STATIC_ASSERT(m68k_stall_snapshot_v1_base, offsetof(struct gpgx_m68k_stall_snapshot_v1, frame_base_mclk) == 16);
+
+void gpgx_m68k_stall_z80_bus(uint32_t mclk)
+{
+  m68k_stall.z80_bus_access_count++;
+  m68k_stall.z80_bus_mclk += mclk;
+}
+
+void gpgx_m68k_stall_fifo(uint32_t before, uint32_t after)
+{
+  if (after > before)
+  {
+    m68k_stall.fifo_wait_count++;
+    m68k_stall.fifo_wait_mclk += after - before;
+  }
+}
+
+void gpgx_m68k_stall_dma(uint32_t before, uint32_t after)
+{
+  if (after > before)
+  {
+    m68k_stall.dma_freeze_count++;
+    m68k_stall.dma_freeze_mclk += after - before;
+  }
+}
+
+void gpgx_m68k_stall_frame_wrap(uint32_t mcycles)
+{
+  m68k_stall.frame_ordinal++;
+  m68k_stall.frame_base_mclk += mcycles;
+}
+
+ECL_EXPORT uint32_t gpgx_m68k_stall_abi_version(void)
+{ return GPGX_M68K_STALL_ABI_VERSION; }
+
+ECL_EXPORT uint32_t gpgx_m68k_stall_snapshot_size(void)
+{ return (uint32_t)sizeof(struct gpgx_m68k_stall_snapshot_v1); }
+
+ECL_EXPORT int32_t gpgx_m68k_stall_enable(uint32_t abi_version)
+{
+  if (abi_version != GPGX_M68K_STALL_ABI_VERSION) return -1;
+  memset(&m68k_stall, 0, sizeof(m68k_stall));
+  gpgx_m68k_stall_refresh_events = 0;
+  gpgx_m68k_stall_enabled = 1;
+  return 0;
+}
+
+ECL_EXPORT int32_t gpgx_m68k_stall_read(struct gpgx_m68k_stall_snapshot_v1 *out, uint32_t size)
+{
+  if (!out || size != sizeof(struct gpgx_m68k_stall_snapshot_v1)) return -2;
+  if (!gpgx_m68k_stall_enabled) return -1;
+  *out = m68k_stall;
+  out->abi_version = GPGX_M68K_STALL_ABI_VERSION;
+  out->struct_size = (uint32_t)sizeof(struct gpgx_m68k_stall_snapshot_v1);
+  out->m68k_cycles = (uint32_t)m68k.cycles;
+  out->refresh_events = gpgx_m68k_stall_refresh_events;
+  return 0;
+}
+
+ECL_EXPORT int32_t gpgx_m68k_stall_disable(void)
+{
+  gpgx_m68k_stall_enabled = 0;
+  return 0;
+}
+
 ECL_EXPORT uint32_t gpgx_s3k_pcm_abi_version(void)
 { return GPGX_S3K_PCM_ABI_VERSION; }
 
