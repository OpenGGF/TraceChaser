--- a/waterbox/gpgx/cinterface/audio_trace.h
+++ b/waterbox/gpgx/cinterface/audio_trace.h
@@ -12,6 +12,9 @@
 #define GPGX_S3K_AUDIO_PARITY_MAX_DESCRIPTORS 64u
 
 #define GPGX_S3K_PCM_ABI_VERSION 1u
+
+/* Observation-only 68000 stall counters (OpenGGF S3K Kos CPU-budget closure); independent of every other ABI. */
+#define GPGX_M68K_STALL_ABI_VERSION 1u
 #define GPGX_S3K_PCM_EVENT_CAPACITY 16384u
 #define GPGX_S3K_PCM_TAP_YM2612_MIX_STEREO 1u
 #define GPGX_S3K_PCM_TAP_PSG_STEREO_NATIVE 2u
@@ -229,6 +232,32 @@ extern uint32_t trace_z80_instruction_pc;
 extern uint32_t trace_m68k_instruction_pc;
 extern volatile uint8_t gpgx_s3k_audio_parity_enabled;
 extern volatile uint8_t gpgx_s3k_pcm_enabled;
+/* Cumulative since gpgx_m68k_stall_enable; MCLK units (7 MCLK = one 68000 cycle). */
+struct gpgx_m68k_stall_snapshot_v1
+{
+  uint32_t abi_version;          /* GPGX_M68K_STALL_ABI_VERSION */
+  uint32_t struct_size;          /* sizeof(struct gpgx_m68k_stall_snapshot_v1) == 80 */
+  uint32_t frame_ordinal;        /* frame-end timing rebases (system.c) since enable */
+  uint32_t m68k_cycles;          /* m68k.cycles when read: MCLK from the current frame start */
+  uint64_t frame_base_mclk;      /* sum of mcycles_vdp over those rebases; base + m68k_cycles is monotonic */
+  uint64_t z80_bus_access_count; /* memz80.c z80_request_68k_bus_access calls */
+  uint64_t z80_bus_mclk;         /* MCLK those calls added to m68k.cycles */
+  uint64_t fifo_wait_count;      /* VDP data-port writes that waited for a full FIFO */
+  uint64_t fifo_wait_mclk;       /* MCLK added by those waits */
+  uint64_t refresh_events;       /* m68k_run bus refresh delays (2*7 MCLK each) */
+  uint64_t dma_freeze_count;     /* 68k-bus DMA freezes */
+  uint64_t dma_freeze_mclk;      /* MCLK added by those freezes */
+};
+
+extern volatile uint8_t gpgx_m68k_stall_enabled;
+extern uint64_t gpgx_m68k_stall_refresh_events;
+void gpgx_m68k_stall_z80_bus(uint32_t mclk);
+void gpgx_m68k_stall_fifo(uint32_t before, uint32_t after);
+void gpgx_m68k_stall_dma(uint32_t before, uint32_t after);
+void gpgx_m68k_stall_frame_wrap(uint32_t mcycles);
+#define GPGX_M68K_STALL_COUNT_REFRESH() \
+  do { if (gpgx_m68k_stall_enabled) gpgx_m68k_stall_refresh_events++; } while (0)
+
 
