diff --git a/waterbox/gpgx/cinterface/audio_trace.c b/waterbox/gpgx/cinterface/audio_trace.c
index f1104ac..06a2b21 100644
--- a/waterbox/gpgx/cinterface/audio_trace.c
+++ b/waterbox/gpgx/cinterface/audio_trace.c
@@ -189,6 +189,7 @@ ECL_INVISIBLE static uint8_t trace_prepublication;
 ECL_INVISIBLE static uint8_t trace_ready_drained;
 ECL_INVISIBLE static struct gpgx_audio_trace_first_fault_v1 trace_first_fault;
 ECL_INVISIBLE static uint16_t trace_arm_hook_index;
+ECL_INVISIBLE static uint8_t trace_s2_request_callback_active;
 ECL_INVISIBLE static uint8_t trace_reset_active;
 ECL_INVISIBLE static uint8_t trace_issue_source;
 ECL_INVISIBLE static uint8_t trace_depth;
@@ -1438,1 +1439,76 @@ void gpgx_audio_trace_leave_cpu(uint8_t previous) { trace_issue_source = previous; }
+void gpgx_audio_trace_s2_request_callback_begin(uint32_t pc)
+{
+  trace_s2_request_callback_active =
+    gpgx_audio_trace_enabled && pc == 0x0010d6u;
+}
+
+void gpgx_audio_trace_s2_request_callback_end(void)
+{
+  trace_s2_request_callback_active = 0;
+}
+
+static int has_fixed_s2_request_markers(void)
+{
+  static const uint8_t opcode[4] = { 0x13u, 0x80u, 0x10u, 0x09u };
+  uint32_t i, marker_count = 0;
+  for (i = 0; i < trace_config.hook_count; i++)
+  {
+    const struct gpgx_audio_service_hook_v1 *hook = &trace_hooks[i];
+    uint16_t expected_token;
+    uint8_t expected_kind;
+    if (hook->action != ACTION_OBSERVATION_MARKER) continue;
+    if (marker_count >= 2u) return 0;
+    expected_token = marker_count ? 25u : 24u;
+    expected_kind = marker_count ? 3u : 0u;
+    if (hook->hook_token != expected_token
+        || hook->cpu != GPGX_AUDIO_TRACE_CPU_M68K
+        || hook->pc != 0x0010d6u
+        || hook->service_kind != 0u
+        || hook->expected_active_kind != expected_kind
+        || hook->flags != 0u
+        || hook->opcode_length != 4u
+        || hook->range_first != 0u
+        || hook->range_count != 0u
+        || memcmp(hook->opcode, opcode, sizeof(opcode))
+        || !bytes_are_zero(hook->reserved, sizeof(hook->reserved))) return 0;
+    marker_count++;
+  }
+  return marker_count == 2u;
+}
+
+static int has_fixed_s2_request_topology(void)
+{
+  const struct trace_stack_entry *root, *active;
+  if (trace_deferred_begin.pending) return 0;
+  if (trace_depth == 0u) return 1;
+  if (trace_depth == 1u)
+  {
+    active = &trace_stack[0];
+    return active->token != 0u && active->parent == 0u
+      && active->kind == 3u && active->depth == 0u;
+  }
+  if (trace_depth != 2u) return 0;
+  root = &trace_stack[0];
+  active = &trace_stack[1];
+  return root->token != 0u && root->parent == 0u
+    && root->kind == 4u && root->depth == 0u
+    && active->token != 0u && active->token != root->token
+    && active->parent == root->token
+    && active->kind == 3u && active->depth == 1u;
+}
+
+ECL_EXPORT int32_t gpgx_audio_trace_s2_request_successor_ordinal(
+  uint32_t *ordinal)
+{
+  if (trace_ready_invalid) return TRACE_ABI_OR_CONFIG_LIMIT;
+  if (trace_phase != PHASE_RECORDING) return TRACE_INVALID_PHASE;
+  if (!ordinal) return TRACE_INVALID_ARGUMENT;
+  if (!trace_s2_request_callback_active
+      || trace_issue_source != GPGX_AUDIO_TRACE_CPU_M68K
+      || !has_fixed_s2_request_topology()
+      || !has_fixed_s2_request_markers()) return TRACE_ABI_OR_CONFIG_LIMIT;
+  *ordinal = trace_event_count_value;
+  return TRACE_OK;
+}
+
 void gpgx_audio_trace_instruction(uint8_t cpu, uint32_t pc)
@@ -1711,6 +1786,7 @@ ECL_EXPORT int32_t gpgx_audio_trace_begin_frame(void)
   trace_event_count_value = trace_omitted_count = trace_protected_tail = 0;
   trace_runtime_error = trace_ready_invalid = trace_reset_active = 0; trace_issue_source = 0;
   trace_ready_drained = 0;
+  trace_s2_request_callback_active = 0;
   trace_z80_instruction_pc = trace_m68k_instruction_pc = 0; trace_next_token = 1;
   for (i = 0; i < trace_depth; i++)
     while (trace_next_token == trace_stack[i].token) trace_next_token++;
@@ -1780,6 +1856,7 @@ ECL_EXPORT int32_t gpgx_audio_trace_abort_frame(void)
   { fail_runtime(GPGX_AUDIO_TRACE_FAULT_SERVICE); return TRACE_ABI_OR_CONFIG_LIMIT; }
   trace_event_count_value = trace_omitted_count = trace_protected_tail = 0;
   trace_runtime_error = trace_ready_invalid = trace_reset_active = 0; trace_issue_source = 0;
+  trace_s2_request_callback_active = 0;
   trace_ready_drained = 0;
   trace_z80_instruction_pc = trace_m68k_instruction_pc = 0;
   trace_depth = 0; memset(trace_stack, 0, sizeof(trace_stack));
@@ -1802,6 +1879,7 @@ ECL_EXPORT int32_t gpgx_audio_trace_disable(void)
   trace_event_count_value = trace_omitted_count = trace_protected_tail = 0;
   trace_runtime_error = trace_ready_invalid = trace_z80_proofs_armed = trace_prepublication = 0;
   trace_ready_drained = trace_reset_active = trace_issue_source = trace_depth = 0;
+  trace_s2_request_callback_active = 0;
   trace_arm_hook_index = UINT16_MAX;
   trace_z80_instruction_pc = trace_m68k_instruction_pc = 0; trace_next_token = 1;
   trace_phase = PHASE_DISABLED; gpgx_audio_trace_enabled = 0;
