{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openggf.override-resume-first-divergence-metadata.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "game", "raw_sha256", "raw_byte_count", "attestation_sha256",
    "record_count", "logical_byte_count", "logical_sha256", "stored_byte_count",
    "stored_sha256", "bundle_relative_root", "bundle_member_inventory",
    "publication_protocol", "namespace_lock_precondition"
  ],
  "properties": {
    "schema": {"const": "openggf.override-resume-first-divergence-metadata.v1"},
    "game": {"enum": ["s1", "s2"]},
    "raw_sha256": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "raw_byte_count": {"type": "integer", "minimum": 1},
    "attestation_sha256": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "record_count": {"const": 1},
    "logical_byte_count": {"type": "integer", "minimum": 1},
    "logical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stored_byte_count": {"type": "integer", "minimum": 1},
    "stored_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bundle_relative_root": {"const": "src/test/resources/audio/parity/override-resume-first-divergence-v1"},
    "bundle_member_inventory": {
      "type": "array",
      "prefixItems": [
        {"const": "s1/s1-override-resume-reference.v1.jsonl.gz"},
        {"const": "s1/s1-override-resume-metadata.v1.json"},
        {"const": "s2/s2-override-resume-reference.v1.jsonl.gz"},
        {"const": "s2/s2-override-resume-metadata.v1.json"}
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "publication_protocol": {"const": "linux-atomic-bundle-rename-noreplace-v1"},
    "namespace_lock_precondition": {"const": "All publishers cooperate through the exclusive fixture-root lock; the authoritative root and ancestors remain namespace-stable and protected from rename and mount mutation. Same-credential rename and mount mutation after validation is unsupported."}
  }
}
